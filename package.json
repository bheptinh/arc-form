{
  "name": "arcform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:fe\" \"npm run dev:be\"",
    "dev:fe": "vite --config client/vite.config.ts --port 5115",
    "dev:be": "tsx watch --env-file=.env server/index.ts",
    "seed": "node --env-file=.env scripts/seed-db.mjs",
    "verify-seed": "node --env-file=.env scripts/verify-seed.mjs",
    "build": "vite build --config client/vite.config.ts && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "NODE_ENV=production node --env-file=.env dist-server/index.js",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@types/multer": "^2.1.0",
    "better-sqlite3": "^12.10.0",
    "classnames": "^2.5.1",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "html-react-parser": "^6.1.1",
    "konva": "^10.3.0",
    "multer": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-jss": "^10.10.0",
    "react-konva": "^19.2.4",
    "react-pdf": "^10.4.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "simplebar-react": "^3.3.2",
    "suneditor": "^2.47.10",
    "swiper": "^8.4.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/redux-logger": "^3.0.13",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "redux-logger": "^3.0.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
